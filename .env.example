# Copy to .env (root) and adjust. Never commit real secrets.
MONGO_URL=mongodb://localhost:27027/coldguard
PORT=4000
# >= 32 random chars in any shared deployment (openssl rand -hex 32)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# Ingest credential for the simulator agent: "<agentId>.<secret>" (only a SHA-256 of the secret is stored)
AGENT_KEY=sim-agent.local-dev-secret-key-change-me
# Password for the seeded demo users (operator, viewer.deccan, viewer.western)
DEMO_PASSWORD=coldguard-demo
# Comma-separated allowed browser origins (dev: Vite)
CORS_ORIGIN=http://localhost:5173
# Allow the operator-only, confirmed "reset demo data" action. Keep false in public deployments.
ALLOW_DEMO_RESET=true
# Spawn the simulator as a child process of the server (single-container hosting)
SIM_AUTOSPAWN=false
# Tunables
QUEUE_CAPACITY=20000
DB_BATCH_MAX=1000
TELEMETRY_EMIT_MS=250
FLEET_EMIT_MS=1000
AGENT_RATE_EPS=5000
RETENTION_HOURS=72
# Time zone used in server-generated incident explanations
DISPLAY_TZ=Asia/Kolkata
